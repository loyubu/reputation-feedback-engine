# ---------------------------------------------------------------------------
# Reputation & Feedback Intelligence Engine — connection details
#
# Copy to .env and fill in. .env is gitignored; this template is not, so
# never put a real value in this file.
#
# n8n Cloud does NOT read this file. Each value is pasted into
# n8n > Credentials by hand. This is the group's record of what goes where,
# and becomes the container's environment if we self-host later.
#
# Thresholds (severity cut-off, confidence floor, history lookback) are NOT
# here — they live in the Config node, per CLAUDE.md.
# ---------------------------------------------------------------------------

# --- n8n --------------------------------------------------------------------
# Instance URL. The form link is built from this in the Config node.
N8N_BASE_URL=https://your-instance.app.n8n.cloud

# --- Anthropic --------------------------------------------------------------
# console.anthropic.com > API Keys. Starts sk-ant-
ANTHROPIC_API_KEY=

# --- Airtable (authoritative store) -----------------------------------------
# airtable.com/create/tokens. Scopes: data.records:read, data.records:write,
# schema.bases:read. Grant access to the one base only. Starts pat
AIRTABLE_PAT=
# From the base URL: airtable.com/appXXXXXXXXXXXXXX/... Starts app
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_FEEDBACK=Feedback

# --- Google Sheets (write-only mirror) --------------------------------------
# n8n Cloud: "Sign in with Google" in the credential — no secret to store.
# The ID is the long string in the sheet URL between /d/ and /edit
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_TAB_NAME=Feedback

# --- Slack (manager alerts) -------------------------------------------------
# n8n Cloud: OAuth2 "Connect my account" is the easy path, no token needed.
# Only if using a bot token instead: api.slack.com/apps > OAuth & Permissions.
# Scopes: chat:write, channels:read. Starts xoxb-
SLACK_BOT_TOKEN=
# Channel > View channel details > bottom of the About tab. Starts C
# The bot must be invited to this channel or posts fail silently.
SLACK_ALERT_CHANNEL_ID=

# --- Email (manager alerts) -------------------------------------------------
# Option A — Gmail: OAuth2 in n8n Cloud, nothing to store here.
# Option B — SMTP. For Gmail SMTP use an App Password, not your login
# password: myaccount.google.com/apppasswords (needs 2-step verification).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Manager alert recipient(s). Several allowed: comma-separated, no spaces,
# e.g. a@gmail.com,b@gmail.com. Goes into the Config node. NEVER take the
# recipient from the feedback payload — that emails the customer.
MANAGER_ALERT_EMAIL=
